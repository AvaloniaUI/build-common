<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nuke.Common" Version="9.0.4"/>
        <PackageReference Include="Nuke.Tooling" Version="9.0.4" />
        <PackageReference Include="Semver" Version="3.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Keep transitive dependencies on patched versions. -->
        <PackageReference Include="Microsoft.Build" Version="17.11.48" />
        <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" />
        <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.48" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48" />
        <PackageReference Include="NuGet.Packaging" Version="6.12.5" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../targets/**/*.*" LinkBase="Targets" />
        <None Include="../branding/**/*.*" LinkBase="Branding" />
        <None Include="../avalonia.snk" />
        <None Include="../babel.rules" />
        <None Include="../Common.props" />
    </ItemGroup>

    <Import Project="../targets/NullableEnable.targets" />
</Project>
